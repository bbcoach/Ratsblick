{
  "name": "ratsblick",
  "version": "0.1.0",
  "private": true,
  "description": "Einheitlicher Zugang zu kommunalen Ratsinformationssystemen – Datenebene (OParl-Abgleich)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "probe": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts probe",
    "sync": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts sync",
    "snapshot": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts snapshot",
    "web": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts web",
    "status": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts status",
    "admin": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts admin",
    "sitze": "node --disable-warning=ExperimentalWarning --import tsx scripts/sitzverteilung.ts",
    "discover": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts discover",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
